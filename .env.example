# Provider-Auswahl: anthropic | scaleway
PROVIDER=anthropic

# Anthropic (Testphase)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Scaleway (spätere Migration) — Modell-ID vor Produktivbetrieb via
# GET https://api.scaleway.ai/v1/models gegen echten Key verifizieren
SCALEWAY_API_KEY=
SCALEWAY_MODEL=glm-5.2
SCALEWAY_BASE_URL=https://api.scaleway.ai/v1

# Meetily-Datenquelle: sqlite | export_folder (export_folder empfohlen)
MEETILY_SOURCE_MODE=export_folder
MEETILY_SOURCE_PATH=./data/meetily_exports

# Speicherorte (relativ zum Projekt-Root)
DATABASE_PATH=./data/app.db
DOWNLOAD_DIR=./data/downloads

# Erster Admin-Nutzer (nur bei `python -m app.db init` verwendet)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Bind-Adresse — Standard: nur lokal/VM-intern erreichbar
HOST=127.0.0.1
PORT=8000
