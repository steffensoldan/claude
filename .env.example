# Provider-Auswahl: anthropic | scaleway
PROVIDER=anthropic

# Anthropic (Testphase)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Scaleway (spätere Migration) — Modell-ID vor Produktivbetrieb via
# GET https://api.scaleway.ai/v1/models gegen echten Key verifizieren
SCALEWAY_API_KEY=
SCALEWAY_MODEL=glm-5.2
SCALEWAY_BASE_URL=https://api.scaleway.ai/v1

# Meetily-Datenquelle: sqlite | export_folder
# sqlite ist verifiziert (siehe docs/meetily-integration-spike.md) — Pfad ist
# pro Nutzer/Installation verschieden, i.d.R.
# %APPDATA%\com.meetily.ai\meeting_minutes.sqlite (per-user-Install) oder
# unter dem jeweiligen Windows-Nutzerprofil bei Pro-Maschine-Install.
# export_folder bleibt Fallback, falls keine Meetily-Installation verfuegbar
# ist (kein bekanntes natives Exportformat in Meetily verifiziert).
MEETILY_SOURCE_MODE=sqlite
MEETILY_SOURCE_PATH=

# Speicherorte (relativ zum Projekt-Root)
DATABASE_PATH=./data/app.db
DOWNLOAD_DIR=./data/downloads

# Erster Admin-Nutzer (nur bei `python -m app.db init` verwendet)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Bind-Adresse — Standard: nur lokal/VM-intern erreichbar
HOST=127.0.0.1
PORT=8000
