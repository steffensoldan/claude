# Vorlage — nach .env kopieren und befüllen. .env selbst wird NICHT versioniert.

# --- LLM-Provider-Auswahl ('anthropic' oder 'scaleway') ---
WISSKOMM_LLM_PROVIDER=anthropic
WISSKOMM_LLM_MODEL=claude-opus-4-8

# --- Anthropic API (vom Dienst auf der VM zur Laufzeit genutzt) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- Scaleway API (Alternative, OpenAI-kompatibel) ---
# SCW_SECRET_KEY=xxxx-xxxx-xxxx-xxxx
# WISSKOMM_LLM_MODEL=glm-5.2

# --- Deployment-Ziel (nur lokal von deploy.py genutzt) ---
WISSKOMM_VM_HOST=192.168.70.65
WISSKOMM_VM_USER=sts
WISSKOMM_VM_PASSWORD=
WISSKOMM_VM_REMOTE_DIR=/home/sts/wisskomm-viz
# Vorhandene venv auf der VM, über die virtualenv gebootstrapt wird:
WISSKOMM_VM_BOOTSTRAP_PIP=/home/sts/stellar-galaxy/venv/bin/pip

# --- Quarto-Hausdienst (nur von publish_quarto.py / app.py genutzt) ---
WISSKOMM_QUARTO_DIR=/home/sts/wisskomm-quarto-pilot
WISSKOMM_QUARTO_BIN=/home/sts/opt/quarto-1.9.38/bin/quarto
# Optional: abweichender Ablageort der bedienten Publikationen (Default: <projekt>/published)
# WISSKOMM_PUBLISH_DIR=/home/sts/wisskomm-viz/published
