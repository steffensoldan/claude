```{python}
#| label: fig-signal
#| fig-cap: "Effektiver Signal-Anteil λ: Anteil des nominalen CO₂-Preises, der an der Grenze wirkt."
fig, ax = plt.subplots(figsize=(8, 2.8))
labels = signal["label"].tolist()
vals = signal["lambda"].tolist()
for i, (name, val) in enumerate(zip(labels, vals)):
    col = ZEW["blue2"] if float(val) >= 0.99 else ZEW["grey"]
    ax.barh(i, 1.0, color=ZEW["eisblau"], alpha=.35, height=.6)
    ax.barh(i, float(val), color=col, height=.6)
    ax.text(float(val) + .02, i, f"{float(val)*100:.0f} %", va="center", fontweight="bold")
ax.set_yticks(range(len(labels)))
ax.set_yticklabels(labels)
ax.set_xlim(0, 1.15)
ax.invert_yaxis()
ax.set_xticks([])
ax.spines["left"].set_visible(False)
ax.spines["bottom"].set_visible(False)
plt.tight_layout()
plt.show()
```

