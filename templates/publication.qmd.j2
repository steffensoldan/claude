#| label: setup
import pandas as pd
import matplotlib as mpl
import matplotlib.pyplot as plt
import numpy as np

# ZEW-CD-Farben (aus zewEcon)
ZEW = {
    "intrans": "#35484f",       # ZEW Dark Slate
    "eisblau": "#abdadc",       # ZEW Light/Ice Blue
    "blue1": "#abdadc",
    "blue2": "#abdadc",
    "green": "#c8d202",         # ZEW Green/Yellow
    "green_dark": "#c8d202",
    "grey": "#9c9e9f"           # ZEW Medium Gray
}
# Kategorienfarbe je Szenario über den Anfangsbuchstaben (robust ggü. Label-Varianten)
SCEN_LETTER = {"A": ZEW["grey"], "B": ZEW["blue2"], "C": ZEW["green_dark"], "D": ZEW["intrans"]}
mpl.rcParams.update({
    "font.size": 14,
    "text.color": ZEW["intrans"],
    "axes.edgecolor": ZEW["grey"],
    "axes.labelcolor": ZEW["intrans"],
    "xtick.color": ZEW["intrans"],
    "ytick.color": ZEW["intrans"],
    "axes.titlesize": 15,
    "axes.labelsize": 14,
    "axes.spines.top": False,
    "axes.spines.right": False,
    "figure.dpi": 160,
    "font.family": "sans-serif",
    "font.sans-serif": ["Calibri", "DejaVu Sans", "Arial"]
})

signal = pd.read_csv("data/signal.csv")
eu = pd.read_csv("data/scenarios_eu.csv")
try:
    prices = pd.read_csv("data/prices_eu.csv")
except Exception:
    prices = None
