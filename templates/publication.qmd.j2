#| label: fig-eu
#| fig-cap: "Szenarien-Vergleich (Quelle: DP-Daten)."
# Dynamischer Säulenplot, sucht nach der ersten numerischen Spalte neben 'scenario'
if 'scenario' in eu.columns:
    numeric_cols = [c for c in eu.columns if c != 'scenario' and pd.api.types.is_numeric_dtype(eu[c])]
    if not numeric_cols:
        for c in eu.columns:
            if c != 'scenario':
                try:
                    eu[c] = pd.to_numeric(eu[c])
                    numeric_cols.append(c)
                except (ValueError, TypeError):
                    pass
    if numeric_cols:
        y_col = numeric_cols[0]
        y_label = y_col.replace("_pct", " (%)").replace("_pp", " (pp)").replace("_", " ").title()
        fig, ax = plt.subplots(figsize=(8, 4.0))
        colors = [SCEN_LETTER.get(str(s).strip()[:1], ZEW["blue2"]) for s in eu["scenario"]]
        ax.bar(eu["scenario"], eu[y_col], color=colors, width=.62)
        for x, v in zip(eu["scenario"], eu[y_col]):
            try:
                v_f = float(v)
            except ValueError:
                v_f = 0.0
            offset = 1 if v_f >= 0 else -3
            ax.text(x, v_f + offset, f"{v_f:.1f}".replace(".", ","), ha="center", fontsize=13)
        ax.set_ylabel(y_label)
        plt.tight_layout()
        plt.show()
