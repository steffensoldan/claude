#| label: fig-prices
#| fig-cap: "Import- und Nutzerpreise Flachstahl (% ggü. Baseline)."
if prices is not None:
    x = np.arange(len(prices))
    w = .38
    fig, ax = plt.subplots(figsize=(8, 4.0))
    ax.bar(x - w/2, prices["user_flat_pct"], w, label="Nutzerpreis Flachstahl", color=ZEW["blue2"])
    ax.bar(x + w/2, prices["import_flat_pct"], w, label="Importpreis Flachstahl", color=ZEW["green_dark"])
    ax.set_xticks(x)
    ax.set_xticklabels(prices["scenario"])
    ax.set_ylabel("% ggü. Baseline")
    ax.legend(frameon=False, fontsize=12)
    plt.tight_layout()
    plt.show()
