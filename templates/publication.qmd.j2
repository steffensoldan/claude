#| label: fig-prices
#| fig-cap: "Szenarien-Vergleich weiterer Metriken (Quelle: DP-Daten)."
# Dynamischer Säulenplot, sucht nach numerischen Spalten neben 'scenario'
if prices is not None and 'scenario' in prices.columns:
    numeric_cols = [c for c in prices.columns if c != 'scenario' and pd.api.types.is_numeric_dtype(prices[c])]
    if not numeric_cols:
        for c in prices.columns:
            if c != 'scenario':
                try:
                    prices[c] = pd.to_numeric(prices[c])
                    numeric_cols.append(c)
                except (ValueError, TypeError):
                    pass
    if len(numeric_cols) >= 1:
        fig, ax = plt.subplots(figsize=(8, 4.0))
        x = np.arange(len(prices))
        w = .38
        if len(numeric_cols) >= 2:
            col1, col2 = numeric_cols[0], numeric_cols[1]
            label1 = col1.replace("_pct", "").replace("_", " ").title()
            label2 = col2.replace("_pct", "").replace("_", " ").title()
            ax.bar(x - w/2, prices[col1], w, label=label1, color=ZEW["blue2"])
            ax.bar(x + w/2, prices[col2], w, label=label2, color=ZEW["green_dark"])
            ax.legend(frameon=False, fontsize=12)
        else:
            col1 = numeric_cols[0]
            label1 = col1.replace("_pct", "").replace("_", " ").title()
            ax.bar(x, prices[col1], w*2, label=label1, color=ZEW["blue2"])
        ax.set_xticks(x)
        ax.set_xticklabels(prices["scenario"])
        ax.set_ylabel("Wert")
        plt.tight_layout()
        plt.show()
