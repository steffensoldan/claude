#| label: fig-eu
#| fig-cap: "Carbon-Leakage-Rate je EU-Szenario (Quelle: DP-Daten)."
fig, ax = plt.subplots(figsize=(8, 4.0))
colors = [SCEN_LETTER.get(str(s).strip()[:1], ZEW["blue2"]) for s in eu["scenario"]]
ax.bar(eu["scenario"], eu["leakage_pct"], color=colors, width=.62)
for x, v in zip(eu["scenario"], eu["leakage_pct"]):
    ax.text(x, float(v) + 1, f"{float(v):.1f}".replace(".", ","), ha="center", fontsize=13)
ax.set_ylabel("Leakage-Rate (%)")
plt.tight_layout()
plt.show()
